# Public site origin — used for canonical URLs, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://bouldhq.com

# NAP (name / address / phone). Must match the Google Business Profile EXACTLY.
# The real number is the default in lib/site.ts; these only override it (e.g. a
# preview deploy that should not ring the real phone). E.164 for the tel: link
# and the JSON-LD, the human-readable form for display.
NEXT_PUBLIC_BOULD_PHONE=
NEXT_PUBLIC_BOULD_PHONE_DISPLAY=

# Google Business Profile URL, once the profile is verified (brief: visibility item 1).
NEXT_PUBLIC_GBP_URL=

# Analytics / verification
NEXT_PUBLIC_GA4_ID=
# Google Ads (Minnesota campaign). The tag loads on every page with the AW- ID;
# each conversion fires only when its label is set too (Ads → Goals → Conversions).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta Pixel (Events Manager → Data sources). Fires PageView and, on every accepted form, Lead.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Lead delivery. RESEND_API_KEY + LEAD_TO_EMAIL enable email delivery of
# ranking-check, contact and callback submissions; without them /api/lead still accepts and logs leads.
RESEND_API_KEY=
LEAD_TO_EMAIL=jake@bouldhq.com

# Lead sheet (integrations/lead-sheet/README.md). Copies every lead into the
# "Bould Leads" Google Sheet and triggers the instant call alert. Optional.
LEAD_SHEET_WEBHOOK_URL=
LEAD_SHEET_SECRET=

# Cloudflare Turnstile (bot check on the lead forms). Both unset = off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Twilio: the automatic "got your request" text to every Minnesota quote lead.
# The from-number must be registered for A2P 10DLC. All three unset = off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# BouldLeads (the call-list app). Saves ranking-check requests as leads tagged
# "Site request" (Minnesota quote requests as "Google ads MN"), runs the top-3 check, and serves the /check/[slug] results
# pages. BOULDLEADS_SECRET must equal PUBLIC_API_SECRET in BouldLeads.
BOULDLEADS_URL=
BOULDLEADS_SECRET=

# Prospect engine (scripts/prospect/README.md). Local only — never set on Vercel.
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
