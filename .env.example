# Public site origin — used for canonical URLs, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://bouldhq.com

# NAP (name / address / phone). Must match the Google Business Profile EXACTLY.
# Leave NEXT_PUBLIC_BOULD_PHONE empty until the real number exists — the footer,
# header, and JSON-LD all omit the phone rather than render a placeholder.
NEXT_PUBLIC_BOULD_PHONE=
NEXT_PUBLIC_BOULD_PHONE_DISPLAY=

# Google Business Profile URL, once the profile is verified (brief: visibility item 1).
NEXT_PUBLIC_GBP_URL=

# Analytics / verification
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Lead delivery. RESEND_API_KEY + LEAD_TO_EMAIL enable email delivery of audit
# and contact submissions; without them /api/lead still accepts and logs leads.
RESEND_API_KEY=
LEAD_TO_EMAIL=jake@bouldhq.com
