# Public site origin — used for canonical URLs, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://bouldhq.com

# NAP (name / address / phone). Must match the Google Business Profile EXACTLY.
# The real number is the default in lib/site.ts; these only override it (e.g. a
# preview deploy that should not ring the real phone). E.164 for the tel: link
# and the JSON-LD, the human-readable form for display.
NEXT_PUBLIC_BOULD_PHONE=
NEXT_PUBLIC_BOULD_PHONE_DISPLAY=

# Google Business Profile URL, once the profile is verified (brief: visibility item 1).
NEXT_PUBLIC_GBP_URL=

# Analytics / verification
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Lead delivery. RESEND_API_KEY + LEAD_TO_EMAIL enable email delivery of audit
# and contact submissions; without them /api/lead still accepts and logs leads.
RESEND_API_KEY=
LEAD_TO_EMAIL=jake@bouldhq.com

# Lead sheet (integrations/lead-sheet/README.md). Copies every lead into the
# "Bould Leads" Google Sheet and triggers the instant call alert. Optional.
LEAD_SHEET_WEBHOOK_URL=
LEAD_SHEET_SECRET=

# Prospect engine (scripts/prospect/README.md). Local only — never set on Vercel.
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
